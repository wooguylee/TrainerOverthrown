<Window x:Class="VVooOverthrown.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VVooOverthrown · Overthrown 한글 패치 &amp; 오프라인 트레이너"
        Height="720" Width="1040" MinHeight="620" MinWidth="900"
        Background="#111827" Foreground="#F8FAFC"
        FontFamily="Malgun Gothic">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="VVooOverthrown" FontSize="34" FontWeight="Bold" />
            <TextBlock Text="한글 패치와 싱글플레이 전용 트레이너" Margin="0,5,0,0"
                       Foreground="#94A3B8" FontSize="16" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,24,0,0" Padding="20" Background="#1E293B" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="게임 경로" Margin="0,4,16,0" Foreground="#94A3B8" />
                <TextBox Grid.Column="1" Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,7" Background="#0F172A" Foreground="White" BorderBrush="#334155" />
                <TextBlock Grid.Row="1" Text="현재 상태" Margin="0,18,16,0" Foreground="#94A3B8" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StatusMessage}"
                           Margin="0,18,0,0" FontWeight="SemiBold" Foreground="#38BDF8" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,20,0,20">
            <Button Content="상태 새로고침" Click="Refresh_Click" />
            <Button Content="한글 패치 설치" Click="Install_Click" IsEnabled="{Binding CanInstall}" />
            <Button Content="안전하게 제거" Click="Remove_Click" IsEnabled="{Binding CanRemove}" Background="#475569" />
            <Button Content="게임 실행" Click="Launch_Click" Background="#059669" />
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Border Padding="20" Background="#1E293B" CornerRadius="10" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="트레이너 기능" FontSize="20" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Helper 연결" Click="ConnectHelper_Click"
                                IsEnabled="{Binding CanConnectHelper}" />
                        <TextBlock Text="{Binding SessionMessage}" VerticalAlignment="Center"
                                   Foreground="#38BDF8" FontWeight="SemiBold" />
                    </StackPanel>

                    <Border Margin="0,18,0,0" Padding="14" Background="#0F172A" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="플레이어 무적" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="켜기" Click="GodModeOn_Click" IsEnabled="{Binding CanUseTrainer}" />
                                <Button Content="끄기" Click="GodModeOff_Click" IsEnabled="{Binding CanUseTrainer}"
                                        Background="#475569" />
                                <TextBlock VerticalAlignment="Center" Foreground="#94A3B8">
                                    <Run Text="활성: " /><Run Text="{Binding GodModeEnabled, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Margin="0,10,0,0" Padding="14" Background="#0F172A" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="월드 시간 배속" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="0.5x" Click="TimeHalf_Click" IsEnabled="{Binding CanUseTrainer}" />
                                <Button Content="1.0x" Click="TimeNormal_Click" IsEnabled="{Binding CanUseTrainer}" />
                                <Button Content="2.0x" Click="TimeDouble_Click" IsEnabled="{Binding CanUseTrainer}" />
                                <TextBlock Text="{Binding TimeScaleMessage}" VerticalAlignment="Center"
                                           Foreground="#94A3B8" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Margin="0,18,0,0" Text="지원 준비 중" Foreground="#FBBF24" FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0" Foreground="#94A3B8" TextWrapping="Wrap"
                               Text="기력 · 이동 속도 · 인벤토리 · 왕국 자원은 안전한 쓰기 경로 검증 전이라 비활성입니다." />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="20" Background="#1E293B" CornerRadius="10" Margin="12,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="작업 기록" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
                    <TextBox Text="{Binding EventLog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Background="#0F172A" Foreground="#CBD5E1"
                             BorderBrush="#334155" Padding="10" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
