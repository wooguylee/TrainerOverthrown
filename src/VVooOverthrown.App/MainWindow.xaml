<Window x:Class="VVooOverthrown.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VVooOverthrown · Overthrown 한글 패치 &amp; 테스트 트레이너"
        Height="800" Width="1240" MinHeight="700" MinWidth="1040"
        Background="#111827" Foreground="#F8FAFC"
        FontFamily="Malgun Gothic">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#334155" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#334155" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2563EB" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="Background" Value="#334155" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2563EB" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FeatureCard" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="VVooOverthrown" FontSize="32" FontWeight="Bold" />
            <TextBlock Text="한글 패치와 현재 빌드용 확장 테스트 트레이너" Margin="0,4,0,0"
                       Foreground="#94A3B8" FontSize="15" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,18,0,0" Padding="16" Background="#1E293B" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="게임 경로" Margin="0,4,16,0" Foreground="#94A3B8" />
                <TextBox Grid.Column="1" Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="1" Text="현재 상태" Margin="0,14,16,0" Foreground="#94A3B8" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StatusMessage}"
                           Margin="0,14,0,0" FontWeight="SemiBold" Foreground="#38BDF8" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,14">
            <Button Content="상태 새로고침" Click="Refresh_Click" />
            <Button Content="한글 패치 설치" Click="Install_Click" IsEnabled="{Binding CanInstall}" />
            <Button Content="안전하게 제거" Click="Remove_Click" IsEnabled="{Binding CanRemove}" Background="#475569" />
            <Button Content="게임 실행" Click="Launch_Click" Background="#059669" />
        </StackPanel>

        <Border Grid.Row="3" Margin="0,0,0,14" Padding="14" Background="#1E293B" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="Helper 연결 / 상태 갱신" Click="ConnectHelper_Click"
                        IsEnabled="{Binding CanConnectHelper}" />
                <TextBlock Grid.Column="1" Text="{Binding SessionMessage}" VerticalAlignment="Center"
                           Foreground="#38BDF8" FontWeight="SemiBold" Margin="8,0" />
                <TextBlock Grid.Column="2" Text="빌드 해시 검사는 유지 · 세션 제한은 진단 전용"
                           VerticalAlignment="Center" Foreground="#FBBF24" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Padding="14" Background="#1E293B" CornerRadius="10" Margin="0,0,10,0">
                <TabControl Background="#1E293B" BorderThickness="0">
                    <TabItem Header="플레이어">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource FeatureCard}">
                                    <StackPanel>
                                        <TextBlock Text="체력 / 무적" Style="{StaticResource SectionTitle}" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="즉시 회복" Click="Heal_Click" IsEnabled="{Binding CanUseTrainer}" Background="#059669" />
                                            <Button Content="무적 켜기" Click="GodModeOn_Click" IsEnabled="{Binding CanUseTrainer}" />
                                            <Button Content="무적 끄기" Click="GodModeOff_Click" IsEnabled="{Binding CanUseTrainer}" Background="#475569" />
                                            <TextBlock VerticalAlignment="Center" Foreground="#94A3B8">
                                                <Run Text="활성: " /><Run Text="{Binding GodModeEnabled, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FeatureCard}">
                                    <StackPanel>
                                        <TextBlock Text="기력 회복 배율" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="0~1000x를 직접 입력합니다. 0x는 회복 중지, 1x는 원래 값입니다." Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                                        <WrapPanel>
                                            <TextBox Width="120" Margin="0,0,8,0" Text="{Binding StaminaFactorInput.Text, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Content="적용" Click="ApplyStaminaFactor_Click" IsEnabled="{Binding StaminaFactorInput.CanApply}" Background="#059669" />
                                            <TextBlock Text="{Binding StaminaFactorInput.Message}" VerticalAlignment="Center" Foreground="#FBBF24" Margin="0,0,14,0" />
                                            <TextBlock VerticalAlignment="Center" Foreground="#94A3B8">
                                                <Run Text="현재: " /><Run Text="{Binding StaminaFactorMessage, Mode=OneWay}" />
                                            </TextBlock>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="이동·시간">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource FeatureCard}">
                                    <StackPanel>
                                        <TextBlock Text="Ctrl 신속 이동 무한" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="기력 회복을 100x로 올리고 로컬 플레이어의 신속 이동 쿨다운을 제거합니다. 공중 돌진 횟수와 행동 제한은 유지됩니다."
                                                   Style="{StaticResource MutedText}" Margin="0,0,0,10" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="무한 켜기" Click="InfiniteCtrlMovementOn_Click" IsEnabled="{Binding CanUseTrainer}" Background="#059669" />
                                            <Button Content="무한 끄기" Click="InfiniteCtrlMovementOff_Click" IsEnabled="{Binding CanUseTrainer}" Background="#475569" />
                                            <TextBlock VerticalAlignment="Center" Foreground="#94A3B8">
                                                <Run Text="활성: " /><Run Text="{Binding InfiniteCtrlMovementEnabled, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FeatureCard}">
                                    <StackPanel>
                                        <TextBlock Text="플레이어 이동 속도" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="로컬 플레이어의 기본 이동 속도를 0~1000x 범위로 조절합니다." Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                                        <WrapPanel>
                                            <TextBox Width="120" Margin="0,0,8,0" Text="{Binding MovementSpeedInput.Text, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Content="적용" Click="ApplyMovementSpeed_Click" IsEnabled="{Binding MovementSpeedInput.CanApply}" Background="#059669" />
                                            <TextBlock Text="{Binding MovementSpeedInput.Message}" VerticalAlignment="Center" Foreground="#FBBF24" Margin="0,0,14,0" />
                                            <TextBlock VerticalAlignment="Center" Foreground="#94A3B8">
                                                <Run Text="현재: " /><Run Text="{Binding MovementSpeedMessage, Mode=OneWay}" />
                                            </TextBlock>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FeatureCard}">
                                    <StackPanel>
                                        <TextBlock Text="월드 시간 배속" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="게임 전체 시간 흐름을 0~1000x 범위로 조절합니다. 0x는 일시정지입니다." Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                                        <WrapPanel>
                                            <TextBox Width="120" Margin="0,0,8,0" Text="{Binding TimeScaleInput.Text, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Content="적용" Click="ApplyTimeScale_Click" IsEnabled="{Binding TimeScaleInput.CanApply}" Background="#059669" />
                                            <TextBlock Text="{Binding TimeScaleInput.Message}" VerticalAlignment="Center" Foreground="#FBBF24" Margin="0,0,14,0" />
                                            <TextBlock VerticalAlignment="Center" Foreground="#94A3B8">
                                                <Run Text="현재: " /><Run Text="{Binding TimeScaleMessage, Mode=OneWay}" />
                                            </TextBlock>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FeatureCard}">
                                    <StackPanel>
                                        <TextBlock Text="일반 점프" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="제자리·전방·측면 등 일반 점프의 상승 속도를 0~1000x 범위로 조절합니다." Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                                        <WrapPanel>
                                            <TextBox Width="120" Margin="0,0,8,0" Text="{Binding RegularJumpInput.Text, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Content="적용" Click="ApplyRegularJumpMultiplier_Click" IsEnabled="{Binding RegularJumpInput.CanApply}" Background="#059669" />
                                            <TextBlock Text="{Binding RegularJumpInput.Message}" VerticalAlignment="Center" Foreground="#FBBF24" Margin="0,0,14,0" />
                                            <TextBlock VerticalAlignment="Center" Foreground="#94A3B8">
                                                <Run Text="현재: " /><Run Text="{Binding RegularJumpMultiplierMessage, Mode=OneWay}" />
                                            </TextBlock>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FeatureCard}">
                                    <StackPanel>
                                        <TextBlock Text="특수 이동" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="벽·난간·수영·삽·자동 스텝·볼트·회전 점프 등 특수 이동의 상승 속도를 0~1000x 범위로 조절합니다." Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                                        <WrapPanel>
                                            <TextBox Width="120" Margin="0,0,8,0" Text="{Binding SpecialMovementInput.Text, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Content="적용" Click="ApplySpecialMovementMultiplier_Click" IsEnabled="{Binding SpecialMovementInput.CanApply}" Background="#059669" />
                                            <TextBlock Text="{Binding SpecialMovementInput.Message}" VerticalAlignment="Center" Foreground="#FBBF24" Margin="0,0,14,0" />
                                            <TextBlock VerticalAlignment="Center" Foreground="#94A3B8">
                                                <Run Text="현재: " /><Run Text="{Binding SpecialMovementMultiplierMessage, Mode=OneWay}" />
                                            </TextBlock>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FeatureCard}">
                                    <StackPanel>
                                        <TextBlock Text="중력" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="기본 중력 가속도를 0~1000x 범위로 조절합니다. 0x는 기본 중력 가속도를 제거합니다." Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                                        <WrapPanel>
                                            <TextBox Width="120" Margin="0,0,8,0" Text="{Binding GravityInput.Text, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Content="적용" Click="ApplyGravityMultiplier_Click" IsEnabled="{Binding GravityInput.CanApply}" Background="#059669" />
                                            <TextBlock Text="{Binding GravityInput.Message}" VerticalAlignment="Center" Foreground="#FBBF24" Margin="0,0,14,0" />
                                            <TextBlock VerticalAlignment="Center" Foreground="#94A3B8">
                                                <Run Text="현재: " /><Run Text="{Binding GravityMultiplierMessage, Mode=OneWay}" />
                                            </TextBlock>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="인벤토리">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource FeatureCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.ColumnSpan="2" Text="로컬 플레이어 자원" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Grid.Row="1" Text="자원" VerticalAlignment="Center" Foreground="#94A3B8" />
                                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ResourceOptions}"
                                                  SelectedItem="{Binding SelectedInventoryResource}" DisplayMemberPath="Label" />
                                        <TextBlock Grid.Row="2" Text="수량" Margin="0,12,0,0" VerticalAlignment="Center" Foreground="#94A3B8" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
                                            <TextBox Text="{Binding InventoryAmountInput, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="{Binding InventoryInputMessage}" Margin="0,4,0,0" Foreground="#FBBF24" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                                            <Button Content="현재값 조회" Click="InventoryQuery_Click" IsEnabled="{Binding CanUseTrainer}" Background="#475569" />
                                            <Button Content="해당 수량으로 설정" Click="InventorySet_Click" IsEnabled="{Binding CanMutateInventoryResource}" />
                                            <Button Content="입력 수량 추가" Click="InventoryAdd_Click" IsEnabled="{Binding CanMutateInventoryResource}" Background="#059669" />
                                            <Button Content="입력 수량 차감" Click="InventorySubtract_Click" IsEnabled="{Binding CanMutateInventoryResource}" Background="#DC2626" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding InventoryResultMessage}" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" />
                                <TextBlock Margin="0,10,0,0" Text="설정·추가·차감은 저장되는 게임 상태를 직접 바꿉니다. 자동 실게임 검증에서는 조회만 수행합니다."
                                           Foreground="#FBBF24" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="왕국 자원">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource FeatureCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.ColumnSpan="2" Text="전역 왕국 자원 저장소" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Grid.Row="1" Text="자원" VerticalAlignment="Center" Foreground="#94A3B8" />
                                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ResourceOptions}"
                                                  SelectedItem="{Binding SelectedKingdomResource}" DisplayMemberPath="Label" />
                                        <TextBlock Grid.Row="2" Text="수량" Margin="0,12,0,0" VerticalAlignment="Center" Foreground="#94A3B8" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
                                            <TextBox Text="{Binding KingdomAmountInput, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="{Binding KingdomInputMessage}" Margin="0,4,0,0" Foreground="#FBBF24" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                                            <Button Content="현재값 조회" Click="KingdomQuery_Click" IsEnabled="{Binding CanUseTrainer}" Background="#475569" />
                                            <Button Content="해당 수량으로 설정" Click="KingdomSet_Click" IsEnabled="{Binding CanMutateKingdomResource}" />
                                            <Button Content="입력 수량 추가" Click="KingdomAdd_Click" IsEnabled="{Binding CanMutateKingdomResource}" Background="#059669" />
                                            <Button Content="입력 수량 차감" Click="KingdomSubtract_Click" IsEnabled="{Binding CanMutateKingdomResource}" Background="#DC2626" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding KingdomResultMessage}" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" />
                                <TextBlock Margin="0,10,0,0" Text="왕국 자원 변경은 게임의 Deposit/Withdraw 경로를 사용하며 저장 데이터에 남을 수 있습니다."
                                           Foreground="#FBBF24" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="진단">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource FeatureCard}">
                                    <StackPanel>
                                        <TextBlock Text="런타임 상태" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding DiagnosticMessage}" TextWrapping="Wrap" Foreground="#CBD5E1" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FeatureCard}">
                                    <StackPanel>
                                        <TextBlock Text="Helper 기능 목록" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding CapabilitiesMessage}" TextWrapping="Wrap" Foreground="#94A3B8" />
                                    </StackPanel>
                                </Border>
                                <Button Content="일시 변경값 전체 복원" Click="ResetTrainer_Click"
                                        IsEnabled="{Binding CanUseTrainer}" Background="#DC2626" HorizontalAlignment="Left" />
                                <TextBlock Margin="0,10,0,0" Text="무적·기력·Ctrl 신속 이동·이동 속도·시간 배속·일반 점프·특수 이동·중력을 복원합니다. 인벤토리와 왕국 자원 변경은 되돌리지 않습니다."
                                           Foreground="#FBBF24" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Column="1" Padding="16" Background="#1E293B" CornerRadius="10" Margin="10,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="작업 기록" FontSize="19" FontWeight="Bold" Margin="0,0,0,10" />
                    <TextBox Text="{Binding EventLog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Background="#0F172A" Foreground="#CBD5E1"
                             BorderBrush="#334155" Padding="10" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
